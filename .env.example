# Puerto de la aplicación (en Render se asigna automáticamente mediante $PORT)
PORT=8000

# Token del bot de Telegram obtenido de @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Tu Chat ID numérico privado obtenido con @userinfobot (solo tú podrás interactuar)
TELEGRAM_CHAT_ID=123456789

# Token de GitHub (Personal Access Token con permiso 'repo') para respaldo automático de agenda.db
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Nombre de tu repositorio en formato 'usuario/nombre-del-repo'
GITHUB_REPO=tu-usuario/mi-asistente-bot

# Opcional: Clave de Groq para transcripción gratuita ultrarrápida de notas de voz de Telegram con Whisper
# Obténla gratis en: https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
